# Copy to /opt/premnath-backup/.env on the VPS, fill in, then: chmod 600 .env
# Wrap every value in single quotes. Never commit the filled file.

# --- Microsoft Graph (same values as the ERP app's Dokploy env) ---
AZURE_TENANT_ID=''
AZURE_CLIENT_ID=''
AZURE_CLIENT_SECRET=''
SHAREPOINT_SITE_ID=''
# Optional: a specific document library; empty = the site's default "Documents"
SHAREPOINT_DRIVE_ID=''
# Folder inside the library; Daily/Weekly/Monthly are created under it
SHAREPOINT_BACKUP_FOLDER='Database Backups'

# --- Database (verify with: docker ps --format '{{.Names}}') ---
# Container name or its prefix (Dokploy adds ".1.<id>" to swarm containers)
DB_CONTAINER='premnathrailportal-database'
# The database the ERP actually uses (last part of DATABASE_URL in Dokploy)
DB_NAME=''
# Optional: empty = the container's own POSTGRES_USER
DB_USER=''
# Backup fails if the dump has fewer tables (catches an empty/wrong database)
MIN_TABLES='100'

# --- Encryption (AES-256, gpg). Keep a copy of this key in the password manager! ---
ENCRYPTION_KEY_FILE='/root/.premnath-backup.key'

# --- Retention ---
BACKUP_DIR='/var/backups/premnathrail'
LOCAL_KEEP_DAYS='7'
KEEP_DAILY='30'
KEEP_WEEKLY='12'
KEEP_MONTHLY='12'

# --- Failure alert (optional): Teams channel -> Workflows -> "Send webhook alerts to a channel" URL ---
ALERT_WEBHOOK_URL=''
